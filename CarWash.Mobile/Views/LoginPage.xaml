<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarWash.Mobile.Views.LoginPage"
             Title="CarWash"
             BackgroundColor="{StaticResource Primary}">

    <VerticalStackLayout Padding="32"
                         Spacing="20"
                         VerticalOptions="Center">

        <Label Text="🚗 CarWash"
               FontSize="36"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center" />

        <Label Text="Inicia sesión para continuar"
               FontSize="14"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,0,0,16" />

        <Border StrokeShape="RoundRectangle 12" Padding="16" BackgroundColor="White" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Usuario" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="txtUsuario"
                           Placeholder="Ingrese su usuario"
                           ReturnType="Next"
                           ReturnCommand="{Binding Source={x:Reference txtPassword}, Path=Focus}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Contraseña" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="txtPassword"
                           Placeholder="Ingrese su contraseña"
                           IsPassword="True"
                           ReturnType="Done"
                           ReturnCommand="{Binding Source={x:Reference btnLogin}, Path=Command}" />
                </VerticalStackLayout>

                <Button x:Name="btnLogin"
                        Text="Ingresar"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnLoginClicked" />

                <ActivityIndicator x:Name="loader"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <Label x:Name="lblError"
                       Text=""
                       TextColor="Red"
                       FontSize="13"
                       IsVisible="False"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>
